

ll ex_gcd(ll a, ll b, ll& x, ll& y) {
    if (b == 0) {
        x = 1;
        y = 0;
        return a;
    }
    ll x1, y1;
    ll d = ex_gcd(b, a % b, x1, y1);
    x = y1;
    y = x1 - y1 * (a / b);
    return d;
}


ll mod_inv(ll a, ll m){
    ll x, y;
    ll g = ex_gcd(a, m, x, y);
    // we assume g is 1 (other wise no solution)
    return (x%m + m)%m;

}

struct Congruence {
    ll a, m;
};

ll chinese_remainder_theorem(vector<Congruence> const& congruences) {
    // This assumes all modulos are coprime (otherwise no solution)
    ll M = 1;
    for (auto const& congruence : congruences) {
        M *= congruence.m;
    }

    ll solution = 0;
    for (auto const& congruence : congruences) {
        long long a_i = congruence.a;
        long long M_i = M / congruence.m;
        long long N_i = mod_inv(M_i, congruence.m);
        solution = (solution + a_i * M_i % M * N_i) % M;
    }
    return solution;
}
