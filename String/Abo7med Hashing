
mt19937_64 rng(chrono::steady_clock::now().time_since_epoch().count());

const ll M = 1e9+7;
const ll BASE = uniform_int_distribution<ll>(0.25*M, 0.75*M)(rng);

struct HashedString {
    int sz;
    vector<ll> p_hash, pow;
    HashedString(string &s){
        sz = s.size();
        p_hash.resize(sz+1);
        pow.resize(sz+1);
        pow[0]=1;
        for(int i=1; i<=sz; i++){
            pow[i] = (pow[i-1]*BASE)%M;
            p_hash[i] = ((p_hash[i-1]*BASE)%M + s[i-1])%M;
        }
    }

    ll getHash(int l, int r){
        return (p_hash[r+1]-(p_hash[l]*pow[r+1-l])%M + M)%M;
    }
};
